# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Which chain the site talks to. "devnet" (default) or "mainnet".
# Every other cluster-dependent value is derived from this one — see
# src/cluster.js. There is deliberately no way for two settings to disagree.
VITE_CLUSTER=devnet

# The RPC endpoint, server-side. Read by the Vite dev proxy and by
# server/index.mjs in production; the browser only ever talks to "/rpc".
#
# THIS IS THE ONE TO SET. Accepts a full URL or a bare Helius API key.
HELIUS_RPC=

# A public RPC endpoint for the browser to use directly, skipping the proxy.
#
# LEAVE EMPTY unless the endpoint carries no secret. Vite inlines every VITE_
# variable into the client bundle at build time, so a paid key here is
# published to everyone who loads the site. Put it in HELIUS_RPC instead.
VITE_RPC=

# Absolute origin this deployment is reachable at. Used by the metadata server
# for the image URLs inside token metadata — wallets and marketplaces fetch
# those, so a relative path would resolve against their origin and 404.
PUBLIC_URL=http://localhost:5173

# --- operations scripts only (never needed to run the site) -----------------
# Keypairs as a JSON array of bytes, on one line. Local runs read the gitignored
# *-wallet.json files instead; these exist so a hosted cron has a way in.
# TREASURY_SECRET=
# POT_SECRET=
# AUTHORITY_SECRET=

# Supabase mirror (optional). The site falls back to it when the RPC is down;
# the cycle job writes it every five minutes. The anon key is public by design:
# row-level security in supabase/schema.sql fences what it can do. The service
# key is server-side only: .env.local here, a variable on the Railway cycle
# service in production.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
